# Copy to .env and fill in. .env is gitignored.

# ollama | gemini  (omit to auto-select: gemini if GEMINI_API_KEY is set)
REDTEAM_PROVIDER=gemini

# Google AI Studio / Gemini API key
GEMINI_API_KEY=
# Optional alias: GOOGLE_API_KEY=

# Gemini default is gemini-2.5-flash; override if you want another model
REDTEAM_MODEL=gemini-2.5-flash

# Optional output-token limit for the selected provider/model; set at most one.
# The selected parameter is passed unchanged to any configured connector.
# Use the parameter supported by your provider/model:
# REDTEAM_MAX_TOKENS=16000
# REDTEAM_MAX_COMPLETION_TOKENS=16000
# Optional reasoning effort for compatible reasoning models only:
# none | low | medium | high | max
# REDTEAM_REASONING_EFFORT=low

# Ollama (used when REDTEAM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# REDTEAM_MODEL=qwen2.5:14b

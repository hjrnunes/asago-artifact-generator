  "cases": [
    {
      "id": "gemma-call-cap",
      "profile": {
        "base_url": "https://models.example.test/v1",
        "model": "m-1",
        "api_key": "key-1",
        "context_window": 32768,
        "max_completion_tokens": 8192,
        "temperature": 1.0,
        "top_p": 0.95,
        "top_k": 64
      },
      "call": {
        "max_completion_tokens": 2048
      },
      "expect": {
        "*": {
          "requests": [
            {
              "model": "m-1",
              "temperature": 1.0,
              "top_p": 0.95,
              "max_completion_tokens": 2048,
              "extra_body": {
                "top_k": 64
              }
            }
          ]
        },
        "consumer": {
          "requests": [
            {
              "model": "m-1",
              "temperature": 0.0,
              "max_completion_tokens": 8192,
              "extra_body": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        }
      },
      "note": "A call-site cap wins without reasoning_effort. The consumer sends the transport's temperature, its own cap and the role's thinking body (I3, I4, I5)."
    },

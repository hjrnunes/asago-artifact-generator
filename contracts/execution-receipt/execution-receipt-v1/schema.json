{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asago.local/contracts/execution-receipt/execution-receipt-v1.schema.json",
  "title": "execution-receipt-v1",
  "description": "What one tool observed when it executed one authored package against one target. The orchestrator writes it beside the tool's native receipt and score reads it. One attempt per repeat; each attempt records its turns (requests and responses), its observation and where that evidence came from, its runtime observations, its detections, and its judge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "package",
    "bundle_digest",
    "execution_status",
    "runtime_status",
    "incomplete_reason",
    "attempts",
    "native"
  ],
  "properties": {
    "schema_version": {"const": "execution-receipt-v1"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "adapter_revision"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "revision": {"$ref": "#/$defs/optional_text"},
        "adapter_revision": {"$ref": "#/$defs/optional_text"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "digest": {"$ref": "#/$defs/optional_sha256"}
      }
    },
    "bundle_digest": {"$ref": "#/$defs/optional_sha256"},
    "execution_status": {"enum": ["completed", "failed", "incomplete"]},
    "runtime_status": {
      "description": "Whether the target runtime started and finished: not_started means the tool never reached the target.",
      "enum": ["completed", "failed", "not_started", null]
    },
    "incomplete_reason": {"$ref": "#/$defs/optional_text"},
    "attempts": {
      "type": "array",
      "items": {"$ref": "#/$defs/attempt"}
    },
    "native": {
      "description": "The tool's own output files, relative to the package's execute output directory.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/relative_path"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "episode": {
      "description": "Optional; only a tool that runs an episode and grades its sealed snapshot writes it. It names the route that drove the run, the evaluation and the snapshot that were graded, the evidence status fixed at the seal, and the verdict as the tool gave it; a file the tool left unreadable is null.",
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "evaluation_id", "snapshot_id", "evidence_status", "verdict"],
      "properties": {
        "route": {
          "description": "The client that drove this run of the episode, chosen per run, such as midojo (MiDojo's own attacker loop).",
          "$ref": "#/$defs/name"
        },
        "evaluation_id": {"$ref": "#/$defs/optional_text"},
        "snapshot_id": {"$ref": "#/$defs/optional_text"},
        "evidence_status": {
          "description": "How completely each evidence source was collected, by source; a source the snapshot does not name was collected completely.",
          "type": ["object", "null"],
          "additionalProperties": {"enum": ["complete", "incomplete", "failed", "not_collected"]}
        },
        "verdict": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["evaluation_id", "snapshot_id", "security", "reason", "validity"],
          "properties": {
            "evaluation_id": {"$ref": "#/$defs/name"},
            "snapshot_id": {"$ref": "#/$defs/name"},
            "security": {
              "description": "True or false when the check was decided; null when the evidence could not decide it (validity invalid).",
              "type": ["boolean", "null"]
            },
            "reason": {"$ref": "#/$defs/optional_text"},
            "validity": {"enum": ["valid", "invalid"]},
            "attempted": {
              "description": "Optional; whether the agent attempted what the security check looks for, a blocked call included. True, false, or null when unknown, as for a verdict whose grade does not say.",
              "type": ["boolean", "null"]
            },
            "blocked": {
              "description": "Optional; whether a refusal stopped the attempt. True, false, or null when unknown (whenever attempted is).",
              "type": ["boolean", "null"]
            },
            "effect_observed": {
              "description": "Optional; whether the security check holds on the calls that ran to their end and the observed state. True, false, or null when unknown.",
              "type": ["boolean", "null"]
            },
            "injection_delivered": {
              "description": "Optional; whether a payload of the episode's plan was emitted at its boundary, from the delivery facts; not proof the agent saw it. True, false, or null when unknown.",
              "type": ["boolean", "null"]
            }
          }
        },
        "call_injections": {
          "description": "Optional; delivery evidence: each call the snapshot records, in the order of the attempt's tool calls, with the injection outcomes the tool sealed in its record. null when the snapshot was unreadable.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["call_id", "function", "injection_outcomes"],
            "properties": {
              "call_id": {"type": "string"},
              "function": {"type": "string"},
              "injection_outcomes": {
                "description": "Each injection instruction that matched the call and how it fared, as the tool sealed it; empty when none matched; null when the record does not say.",
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["instruction_index", "probe_key", "occurrence", "status", "detail"],
                  "properties": {
                    "instruction_index": {"$ref": "#/$defs/count"},
                    "probe_key": {"type": ["string", "null"]},
                    "occurrence": {
                      "description": "Which matching call of the instruction's this was, from 1; 0 for an unmatched call whose arguments did not match the instruction's call arguments, which the instruction does not count.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {"$ref": "#/$defs/name"},
                    "detail": {"type": "string"},
                    "selected": {
                      "description": "Optional, sealed with the outcome's delivery facts; whether the instruction's selector matched a place in the call's result. null when not reported.",
                      "type": ["boolean", "null"]
                    },
                    "transformation": {
                      "description": "Optional, sealed with the outcome's delivery facts; the transformation applied to the payload, null when none was or it was not reported.",
                      "enum": ["identity", "json_string", null]
                    },
                    "emitted": {
                      "description": "Optional, sealed with the outcome's delivery facts; the parts of the returned result that carry the payload where it was placed, empty when none does, null when not reported.",
                      "type": ["array", "null"],
                      "items": {"enum": ["content_block", "structured_content"]}
                    },
                    "payload_sha256": {
                      "description": "Optional; the SHA-256 (lowercase hex) of the exact UTF-8 bytes of the payload text placed for this outcome, before its transformation. null when the outcome emitted nothing or the tool cannot say what it placed. Absent in a receipt written before the field.",
                      "$ref": "#/$defs/optional_sha256"
                    },
                    "slot": {
                      "description": "Optional; the seed slot the payload emitted for this outcome was placed in: the slot's id, the record and the mode it was placed with. null when the outcome emitted nothing, did not place it where the instruction's selector points, or the tool cannot say where it placed it. Absent in a receipt written before the field.",
                      "type": ["object", "null"],
                      "additionalProperties": false,
                      "required": ["id", "record", "mode"],
                      "properties": {
                        "id": {"$ref": "#/$defs/name"},
                        "record": {"$ref": "#/$defs/name"},
                        "mode": {"enum": ["append", "replace"]}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "delivery": {
          "description": "Optional; the delivery facts of the snapshot's calls as the runner's delivery document gave them (MiDojo's DeliveryFact list), in call then instruction order. null when no delivery document was read: unknown, not undelivered.",
          "type": ["array", "null"],
          "items": {"$ref": "#/$defs/delivery_fact"}
        },
        "exposure": {
          "description": "Optional; the exposure the delivery facts derive, at each boundary (emitted, agent_tool_result, model_input) and per instruction of the episode's plan, as the runner's delivery document gave it. null when no delivery document was read: unknown, not unexposed.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["emitted", "agent_tool_result", "model_input", "instructions"],
          "properties": {
            "emitted": {"$ref": "#/$defs/exposure_status"},
            "agent_tool_result": {"$ref": "#/$defs/exposure_status"},
            "model_input": {"$ref": "#/$defs/exposure_status"},
            "instructions": {"type": "array", "items": {"$ref": "#/$defs/instruction_exposure"}}
          }
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "optional_text": {"type": ["string", "null"], "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "optional_count": {"type": ["integer", "null"], "minimum": 0},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
    },
    "outcome": {"enum": ["detected", "not_detected", "inconclusive", null]},
    "http_request": {
      "description": "One HTTP request, field for field as MiDojo's OpenShell HttpRequestRecord: method upper-case, url as logged (query included), the proxy's decision, host (lower-case), port (when the URL names one), path (\"/\" for a URL with no path) and query (without the \"?\") split from the URL, each null where the URL has no such part or could not be split, and raw the log message it was parsed from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url", "decision", "raw"],
      "properties": {
        "method": {"type": "string"},
        "url": {"type": "string"},
        "decision": {"enum": ["allowed", "denied"]},
        "host": {"type": ["string", "null"]},
        "port": {"type": ["integer", "null"]},
        "path": {"type": ["string", "null"]},
        "query": {"type": ["string", "null"]},
        "raw": {"type": "string"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["user", "assistant", "system", "developer"]},
        "content": {"type": "string"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "generation",
        "turns",
        "result",
        "observation",
        "runtime_observations",
        "detections",
        "judge"
      ],
      "properties": {
        "index": {"$ref": "#/$defs/count"},
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_count", "response_status", "error_type"],
          "properties": {
            "request_count": {"$ref": "#/$defs/optional_count"},
            "response_status": {"$ref": "#/$defs/optional_text"},
            "error_type": {"$ref": "#/$defs/optional_text"}
          }
        },
        "turns": {
          "description": "One entry per request the tool sent to the target, in order: a single-turn package has one; a sequential package has one per user turn.",
          "type": "array",
          "items": {"$ref": "#/$defs/turn"}
        },
        "result": {
          "description": "The attempt's measured outcome at the package's claim level.",
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "claim_level", "reason"],
          "properties": {
            "outcome": {"$ref": "#/$defs/outcome"},
            "claim_level": {
              "enum": ["command_attempt", "reply", "state_effect", null]
            },
            "reason": {"$ref": "#/$defs/optional_text"}
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "assistant_messages", "tool_calls"],
          "properties": {
            "source": {
              "enum": ["mcp_recording_proxy", "tool_native", "openshell_events"]
            },
            "assistant_messages": {
              "type": "array",
              "items": {"type": "string"}
            },
            "tool_calls": {
              "description": "Captured target tool calls in call order; detections name them by index.",
              "type": "array",
              "items": {"$ref": "#/$defs/tool_call"}
            }
          }
        },
        "runtime_observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "processes",
            "network_calls_allowed",
            "network_calls_blocked",
            "files_created",
            "files_modified",
            "files_deleted",
            "security_findings"
          ],
          "properties": {
            "source": {"enum": ["openshell", null]},
            "processes": {"type": "array"},
            "network_calls_allowed": {"type": "array"},
            "network_calls_blocked": {"type": "array"},
            "files_created": {"type": "array"},
            "files_modified": {"type": "array"},
            "files_deleted": {"type": "array"},
            "security_findings": {"type": "array"},
            "http_requests": {
              "description": "The HTTP requests the sandbox's policy proxy inspected, allowed and denied, in log order, each as the tool recorded it. Absent or null: not observed (the tool records no HTTP requests, or did not read them). []: observed, and no request was made. Where the episode's evidence_status says the log read was not complete, a list holds the requests read.",
              "type": ["array", "null"],
              "items": {"$ref": "#/$defs/http_request"}
            }
          }
        },
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["detector", "outcome", "reason", "matched_calls"],
            "properties": {
              "detector": {"$ref": "#/$defs/name"},
              "outcome": {"$ref": "#/$defs/outcome"},
              "reason": {"$ref": "#/$defs/optional_text"},
              "matched_calls": {
                "description": "Indices into observation.tool_calls of the offending calls; null when the detector names none.",
                "type": ["array", "null"],
                "items": {"$ref": "#/$defs/count"}
              }
            }
          }
        },
        "judge": {
          "description": "The semantic judge's verdict; null when the package has no judge record.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["verdict", "reason", "request_count"],
          "properties": {
            "verdict": {"$ref": "#/$defs/optional_text"},
            "reason": {"$ref": "#/$defs/optional_text"},
            "request_count": {"$ref": "#/$defs/optional_count"}
          }
        },
        "source_metadata": {
          "description": "Optional; the metadata the tool's own source entry carried for this attempt's run, when the tool records one. Garak's ipi-episodes.json entry carries the package, the claim and the delivery it ran; a tool that keeps no such entry leaves the field out.",
          "type": ["object", "null"]
        }
      }
    },
    "exposure_status": {"enum": ["exposed", "not_exposed", "unknown"]},
    "delivery_fact": {
      "description": "What the interceptor did with one instruction on one recorded call, at its own boundary (contracts/midojo-delivery). selected, transformation and emitted are null when the interceptor did not report them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "function",
        "disposition",
        "turn",
        "interceptor_instruction_index",
        "plan_instruction_index",
        "probe_key",
        "occurrence",
        "status",
        "selected",
        "transformation",
        "emitted"
      ],
      "properties": {
        "call_id": {"type": "string"},
        "function": {"type": "string"},
        "disposition": {"enum": ["forwarded", "denied", "simulated", "blocked", null]},
        "turn": {"type": ["integer", "null"]},
        "interceptor_instruction_index": {"$ref": "#/$defs/count"},
        "plan_instruction_index": {"$ref": "#/$defs/optional_count"},
        "probe_key": {"type": ["string", "null"]},
        "occurrence": {"$ref": "#/$defs/count"},
        "status": {
          "enum": ["applied", "partial", "fallback", "unmatched", "no_result", "too_large", "skipped_occurrence"]
        },
        "selected": {"type": ["boolean", "null"]},
        "transformation": {"enum": ["identity", "json_string", null]},
        "emitted": {"type": ["array", "null"], "items": {"enum": ["content_block", "structured_content"]}}
      }
    },
    "instruction_exposure": {
      "description": "One instruction of the episode's plan: who placed it, its exposure at each boundary its channel has, and why the first boundary that is not exposed is what it is.",
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_instruction_index", "channel", "probe_key", "placed_by", "exposure", "reason"],
      "properties": {
        "plan_instruction_index": {"$ref": "#/$defs/count"},
        "channel": {"type": "string"},
        "probe_key": {"type": ["string", "null"]},
        "placed_by": {"enum": ["interceptor", "host"]},
        "exposure": {
          "type": "object",
          "propertyNames": {"enum": ["emitted", "agent_tool_result", "model_input"]},
          "additionalProperties": {"$ref": "#/$defs/exposure_status"}
        },
        "reason": {"type": "string"}
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "request", "response"],
      "properties": {
        "index": {"$ref": "#/$defs/count"},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["messages"],
          "properties": {
            "messages": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/message"}
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assistant_messages", "tool_call_indices"],
          "properties": {
            "assistant_messages": {
              "type": "array",
              "items": {"type": "string"}
            },
            "tool_call_indices": {
              "type": "array",
              "items": {"$ref": "#/$defs/count"}
            }
          }
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments", "result", "error", "status", "turn_index"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "arguments": {"description": "The decoded call arguments."},
        "result": {"description": "The decoded call result."},
        "error": {"$ref": "#/$defs/optional_text"},
        "status": {"$ref": "#/$defs/optional_text"},
        "turn_index": {"$ref": "#/$defs/optional_count"}
      }
    }
  }
}

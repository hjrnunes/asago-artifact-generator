{
  "$defs": {
    "HandoffFact": {
      "additionalProperties": false,
      "description": "One source-grounded fact with its authority stamp.",
      "properties": {
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "authority": {
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "source",
        "authority"
      ],
      "title": "HandoffFact",
      "type": "object"
    },
    "HandoffGherkin": {
      "additionalProperties": false,
      "description": "Declarative Gherkin: no bindings, no prompt, no detector code.",
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "given": {
          "items": {
            "type": "string"
          },
          "title": "Given",
          "type": "array"
        },
        "when": {
          "items": {
            "type": "string"
          },
          "title": "When",
          "type": "array"
        },
        "then_expected": {
          "items": {
            "type": "string"
          },
          "title": "Then Expected",
          "type": "array"
        },
        "then_unsafe_alternative": {
          "items": {
            "type": "string"
          },
          "title": "Then Unsafe Alternative",
          "type": "array"
        }
      },
      "required": [
        "feature",
        "scenario"
      ],
      "title": "HandoffGherkin",
      "type": "object"
    },
    "HandoffLineage": {
      "additionalProperties": false,
      "description": "Stable identity plus loss/hazard/constraint lineage.",
      "properties": {
        "loss_ids": {
          "items": {
            "type": "string"
          },
          "title": "Loss Ids",
          "type": "array"
        },
        "hazard_ids": {
          "items": {
            "type": "string"
          },
          "title": "Hazard Ids",
          "type": "array"
        },
        "constraint_ids": {
          "items": {
            "type": "string"
          },
          "title": "Constraint Ids",
          "type": "array"
        },
        "ica_slot_id": {
          "default": "",
          "title": "Ica Slot Id",
          "type": "string"
        },
        "ica_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ica Id"
        },
        "controller_id": {
          "default": "",
          "title": "Controller Id",
          "type": "string"
        },
        "control_action_id": {
          "default": "",
          "title": "Control Action Id",
          "type": "string"
        }
      },
      "title": "HandoffLineage",
      "type": "object"
    },
    "HandoffObservation": {
      "additionalProperties": false,
      "description": "Testability metadata without a target result or gold expectation.",
      "properties": {
        "contract_schema": {
          "title": "Contract Schema",
          "type": "string"
        },
        "contract_id": {
          "title": "Contract Id",
          "type": "string"
        },
        "contract_digest": {
          "title": "Contract Digest",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/ObservationCriterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "assessment": {
          "$ref": "#/$defs/ObservationAssessment"
        }
      },
      "required": [
        "contract_schema",
        "contract_id",
        "contract_digest",
        "criteria",
        "assessment"
      ],
      "title": "HandoffObservation",
      "type": "object"
    },
    "HandoffOperation": {
      "additionalProperties": false,
      "description": "A documented operation named only when it is supported and relevant.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "relevance": {
          "title": "Relevance",
          "type": "string"
        },
        "authority": {
          "anyOf": [
            {
              "enum": [
                "criterion_observed_operation",
                "verified_control_action_specialization",
                "safe_observable_outcome_operation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority"
        }
      },
      "required": [
        "name",
        "relevance"
      ],
      "title": "HandoffOperation",
      "type": "object"
    },
    "HandoffRule": {
      "additionalProperties": false,
      "description": "One governing rule the unsafe behavior would violate.",
      "properties": {
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "statement"
      ],
      "title": "HandoffRule",
      "type": "object"
    },
    "ObservationAssessment": {
      "additionalProperties": false,
      "description": "Deterministic testability result persisted with a scenario.",
      "properties": {
        "disposition": {
          "enum": [
            "executable",
            "analytical_only"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "supported_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supported Criteria",
          "type": "array"
        },
        "unsupported_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unsupported Criteria",
          "type": "array"
        }
      },
      "required": [
        "disposition",
        "reason"
      ],
      "title": "ObservationAssessment",
      "type": "object"
    },
    "ObservationCriterion": {
      "additionalProperties": false,
      "description": "One provider-declared outcome and its requested evidence boundary.",
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "outcome": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "observable": {
          "title": "Observable",
          "type": "boolean"
        },
        "claim_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Level"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "operation_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Name"
        },
        "reason": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "outcome",
        "observable",
        "reason"
      ],
      "title": "ObservationCriterion",
      "type": "object"
    },
    "SafeObservableOutcome": {
      "additionalProperties": false,
      "description": "One scenario-specific boundary for the expected safe behavior.\n\nThe statement is semantic prose, while the remaining fields bind that\nprose to the exact evidence boundary supplied to Stage 5.  An\n``analytical_only`` outcome is represented explicitly with\n``observable=False`` and no claim, operation, record, or fact references.",
      "properties": {
        "observable": {
          "title": "Observable",
          "type": "boolean"
        },
        "statement": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "claim_level": {
          "anyOf": [
            {
              "enum": [
                "command_attempt",
                "reply",
                "returned_result",
                "state_effect"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Level"
        },
        "evidence": {
          "anyOf": [
            {
              "enum": [
                "assistant_message",
                "tool_call",
                "tool_result",
                "snapshot"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "operation_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Name"
        },
        "record_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Record Refs",
          "type": "array"
        },
        "fact_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        }
      },
      "required": [
        "observable",
        "statement"
      ],
      "title": "SafeObservableOutcome",
      "type": "object"
    },
    "ScenarioDeduplication": {
      "additionalProperties": false,
      "description": "One scenario's canonical/duplicate disposition.",
      "properties": {
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "canonical",
            "duplicate",
            "analytical_only"
          ],
          "title": "Status",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "key": {
          "$ref": "#/$defs/ScenarioDeduplicationKey"
        }
      },
      "required": [
        "scenario_id",
        "status",
        "key"
      ],
      "title": "ScenarioDeduplication",
      "type": "object"
    },
    "ScenarioDeduplicationKey": {
      "additionalProperties": false,
      "description": "The stable identity used to collapse equivalent executable scenarios.",
      "properties": {
        "uca_id": {
          "minLength": 1,
          "title": "Uca Id",
          "type": "string"
        },
        "control_action_id": {
          "minLength": 1,
          "title": "Control Action Id",
          "type": "string"
        },
        "operation_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Name"
        },
        "claim_level": {
          "enum": [
            "command_attempt",
            "reply",
            "returned_result",
            "state_effect",
            "unknown"
          ],
          "title": "Claim Level",
          "type": "string"
        }
      },
      "required": [
        "uca_id",
        "control_action_id",
        "claim_level"
      ],
      "title": "ScenarioDeduplicationKey",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The versioned scenario handoff envelope.",
  "properties": {
    "schema_version": {
      "const": "scenario-handoff-v1",
      "default": "scenario-handoff-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "default": 1,
      "title": "Scenario Version",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "adversarial",
        "functional"
      ],
      "title": "Kind",
      "type": "string"
    },
    "hypothesis_framing": {
      "title": "Hypothesis Framing",
      "type": "string"
    },
    "narrative": {
      "title": "Narrative",
      "type": "string"
    },
    "attack_tree": {
      "additionalProperties": true,
      "title": "Attack Tree",
      "type": "object"
    },
    "gherkin": {
      "$ref": "#/$defs/HandoffGherkin"
    },
    "semantic_failure_criterion": {
      "title": "Semantic Failure Criterion",
      "type": "string"
    },
    "safe_alternative": {
      "title": "Safe Alternative",
      "type": "string"
    },
    "safe_observable_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafeObservableOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deduplication": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScenarioDeduplication"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "governing_rules": {
      "items": {
        "$ref": "#/$defs/HandoffRule"
      },
      "title": "Governing Rules",
      "type": "array"
    },
    "lineage": {
      "$ref": "#/$defs/HandoffLineage"
    },
    "documented_operations": {
      "items": {
        "$ref": "#/$defs/HandoffOperation"
      },
      "title": "Documented Operations",
      "type": "array"
    },
    "sourced_facts": {
      "items": {
        "$ref": "#/$defs/HandoffFact"
      },
      "title": "Sourced Facts",
      "type": "array"
    },
    "assumptions_and_unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions And Unknowns",
      "type": "array"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/HandoffObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "kind",
    "hypothesis_framing",
    "narrative",
    "attack_tree",
    "gherkin",
    "semantic_failure_criterion",
    "safe_alternative",
    "lineage"
  ],
  "title": "ScenarioHandoff",
  "type": "object"
}
